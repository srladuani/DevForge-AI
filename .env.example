# Copy to .env.local (git-ignored) and fill in. Never commit real values.
DEVFORGE_DB_URL=jdbc:postgresql://localhost:5432/devforge
DEVFORGE_DB_USER=devforge
DEVFORGE_DB_PASSWORD=devforge

# Encrypts users' stored connections. base64 of 32 random bytes:  openssl rand -base64 32
# Losing this key makes stored connections unreadable; rotate by adding a new key version (see ADR-0012).
DEVFORGE_MASTER_KEY=

# simulated (default): built-in simulation, no model is called. real: Claude via each user's own API key (investigate-only for now).
DEVFORGE_AGENT_MODE=simulated

# Comma-separated emails that become platform admins when they first sign in (local profile only)
DEVFORGE_DEV_ADMINS=you@example.com

# Sign-in with your identity provider (OpenID Connect). Leave empty for local development.
DEVFORGE_OIDC_ISSUER_URI=
DEVFORGE_OIDC_CLIENT_ID=
DEVFORGE_OIDC_AUDIENCE=
DEVFORGE_OIDC_ADMIN_VALUE=
